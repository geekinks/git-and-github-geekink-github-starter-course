{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Student record",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "github_username", "display_name", "status"],
  "properties": {
    "student_id": {"type": "string", "pattern": "^GI-[A-Z0-9]+-[0-9]{3,}$"},
    "github_username": {"type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": ["active", "inactive", "alumni"]},
    "source": {"type": "string", "maxLength": 200}
  }
}
