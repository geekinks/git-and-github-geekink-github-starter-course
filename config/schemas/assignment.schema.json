{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assignment",
  "type": "object", "additionalProperties": false,
  "required": ["assignment_id", "course_id", "session_id", "title", "instructions", "learning_objectives", "submission", "validation", "maximum_score", "human_review_required"],
  "properties": {
    "assignment_id": {"$ref": "#/$defs/id"}, "course_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1}, "instructions": {"type": "string", "minLength": 1},
    "learning_objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "due_offset_days": {"type": "integer", "minimum": 0},
    "submission": {"type": "object", "additionalProperties": false, "required": ["method", "requirements"], "properties": {"method": {"enum": ["pull_request", "issue", "file", "external_repository", "mixed"]}, "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "validation": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["required_file", "markdown_heading", "url_field", "metadata"]}, "path": {"type": "string"}, "heading": {"type": "string"}, "field": {"type": "string"}}}},
    "maximum_score": {"type": "number", "minimum": 0}, "human_review_required": {"type": "boolean"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
