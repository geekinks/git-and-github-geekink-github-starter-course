{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course session",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "course_id", "sequence", "title", "duration_minutes", "topics", "objectives", "resources"],
  "properties": {
    "session_id": {"$ref": "#/$defs/id"}, "course_id": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "minimum": 15},
    "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resources": {"type": "array", "items": {"type": "object", "required": ["title", "url"], "additionalProperties": false, "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "local_source": {"type": "string"}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
