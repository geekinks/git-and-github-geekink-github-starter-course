{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course",
  "type": "object",
  "additionalProperties": false,
  "required": ["course_id", "title", "version", "description", "session_ids", "assignment_ids", "completion"],
  "properties": {
    "course_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "duration_weeks": {"type": "integer", "minimum": 1},
    "session_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "assignment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["required_assignment_ids", "minimum_attendance_sessions", "final_assessment_required"],
      "properties": {
        "required_assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "minimum_attendance_sessions": {"type": "integer", "minimum": 0},
        "final_assessment_required": {"type": "boolean"},
        "minimum_final_score": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
